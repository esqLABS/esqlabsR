{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esqlabs.com/esqlabsR/snapshot/2.0/clean/population.schema.json",
  "title": "population (clean)",
  "description": "Identity unified to 'id' (was 'populationId'); proteinOntogenies promoted to a structured array (RATIONALE §2, §3).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "Stable id (was 'populationId'; RATIONALE §3)." },
    "species": { "type": "string" },
    "population": { "type": "string", "description": "OSP population/db name." },
    "numberOfIndividuals": { "type": "integer" },
    "proportionOfFemales": { "type": "number" },
    "weightMin": { "type": ["number", "null"] },
    "weightMax": { "type": ["number", "null"] },
    "weightUnit": { "type": ["string", "null"] },
    "heightMin": { "type": ["number", "null"] },
    "heightMax": { "type": ["number", "null"] },
    "heightUnit": { "type": ["string", "null"] },
    "ageMin": { "type": ["number", "null"] },
    "ageMax": { "type": ["number", "null"] },
    "BMIMin": { "type": ["number", "null"] },
    "BMIMax": { "type": ["number", "null"] },
    "BMIUnit": { "type": ["string", "null"] },
    "proteinOntogenies": {
      "type": "array",
      "description": "Structured (was the string 'CYP3A4:CYP3A4'; RATIONALE §2).",
      "items": {
        "type": "object",
        "properties": {
          "protein": { "type": "string" },
          "ontogeny": { "type": "string" }
        },
        "required": ["protein", "ontogeny"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "species", "population", "numberOfIndividuals"],
  "additionalProperties": false,
  "$comment": "PROVISIONAL: additionalProperties pending team decision (see ISSUE_additionalProperties.md)."
}
