{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esqlabs.com/esqlabsR/snapshot/2.0/clean/application.schema.json",
  "title": "applications (clean)",
  "description": "Array-with-id (was a name-keyed map in faithful; RATIONALE §1).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "parameterSets": {
        "type": "array",
        "items": { "type": "string" },
        "description": "-> applicationParameterSets[].id."
      }
    },
    "required": ["id", "parameterSets"],
    "additionalProperties": false,
    "$comment": "PROVISIONAL: additionalProperties pending team decision (see ISSUE_additionalProperties.md)."
  }
}
