{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esqlabs.com/esqlabsR/snapshot/2.0/faithful/observedData.schema.json",
  "title": "observedData",
  "description": "Observed-data source references (DIFF §9). type is closed in R/observed-data.R.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["excel", "pkml", "script", "programmatic"],
        "description": "Closed enum (DIFF §9, OPEN_QUESTIONS §3, §10)."
      },
      "file": { "type": "string" },
      "importerConfiguration": { "type": "string" },
      "sheets": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["type"],
    "allOf": [
      {
        "if": { "properties": { "type": { "const": "excel" } } },
        "then": { "required": ["file", "importerConfiguration", "sheets"] }
      },
      {
        "if": { "properties": { "type": { "enum": ["pkml", "script"] } } },
        "then": { "required": ["file"] }
      }
    ],
    "additionalProperties": false,
    "$comment": "PROVISIONAL: additionalProperties pending team decision (see ISSUE_additionalProperties.md)."
  }
}
